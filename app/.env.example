# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Settings → API → service_role key. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Full public URL of this deployment (no trailing slash), used to build the
# Google OAuth redirect and Stripe success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The one account that gets redirected to /admin instead of /dashboard and
# is allowed to manage lessons. Must match the Google account's email.
ADMIN_EMAIL=jurajkurek2006@gmail.com

# Stripe (Dashboard → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price object for the one-time 199 EUR "unlock full course" purchase.
STRIPE_PRICE_ID=price_...

# Anthropic (console.anthropic.com) — used to auto-grade text/image/pdf task
# submissions under each lesson's video.
ANTHROPIC_API_KEY=sk-ant-...
