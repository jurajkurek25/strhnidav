# Postgres connection string. Local dev example:
#   postgresql://strhnidav:password@localhost:5432/strhnidav
DATABASE_URL=postgresql://user:password@localhost:5432/strhnidav

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type "Web application"). Authorized redirect URI must be exactly
# {NEXT_PUBLIC_SITE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Secret used to sign/encrypt the session cookie. Generate one with:
#   openssl rand -base64 33
AUTH_SECRET=

# Canonical public URL NextAuth uses to build the Google OAuth redirect —
# same value as NEXT_PUBLIC_SITE_URL below. Required behind a reverse proxy
# (CloudPanel/Nginx): without it NextAuth can end up deriving the request's
# own origin (e.g. http://localhost:7777) instead, which Google then
# rejects with "redirect_uri_mismatch" since only the public URL is
# registered as an authorized redirect URI.
AUTH_URL=http://localhost:3000

# Full public URL of this deployment (no trailing slash) — used for the
# Google OAuth callback, Stripe success/cancel URLs, and the HLS video key
# URI baked into each lesson's playlist.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The one account that gets redirected to /admin instead of /dashboard and
# is allowed to manage lessons. Must match the Google account's email.
ADMIN_EMAIL=jurajkurek2006@gmail.com

# Absolute path to a writable directory for uploaded/generated files
# (lesson videos, thumbnails, documents, audio, task uploads). Defaults to
# ./storage next to the app if unset — set this explicitly in production.
STORAGE_ROOT=/home/strhnidav-kurz/storage

# Stripe (Dashboard → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price object for the one-time 199 EUR "unlock full course" purchase.
STRIPE_PRICE_ID=price_...

# Anthropic (console.anthropic.com) — used to auto-grade text/image/pdf task
# submissions under each lesson's video.
ANTHROPIC_API_KEY=sk-ant-...
